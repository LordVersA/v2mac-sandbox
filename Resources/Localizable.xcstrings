    "Not connected": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وصل نیست"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не подключено"
          }
        }
      }
    },
    "Not in the current signed store index as installed.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به شکل نصب‌شده در فهرست امضاشدهٔ فعلی فروشگاه نیست."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前签名的商店索引中没有与已安装版本一致的条目。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет в текущем подписанном индексе магазина в установленном виде."
          }
        }
      }
    },
    "Paste": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چسباندن"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставить"
          }
        }
      }
