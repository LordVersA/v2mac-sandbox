    },
    "Quit %@": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خروج از %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершить %@"
          }
        }
      }
