{
  "sourceLanguage": "en",
  "strings": {
    "%@ (apps and data)": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (برنامه‌ها و داده‌ها)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（应用和数据）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (приложения и данные)"
          }
        }
      }
    },
    "%@ can't open": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ باز نمی‌شود"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法打开"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не открывается"
          }
        }
      }
    },
    "%@ in %@": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ در %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 中的 %1$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ в %@"
          }
        }
      }
    },
    "Add App": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "افزودن برنامه"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加应用"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить приложение"
          }
        }
      }
    },
    "Add Mini VM": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "افزودن ماشین مجازی کوچک"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加迷你虚拟机"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить мини-ВМ"
          }
        }
      }
    },
    "Allow and Install": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازه و نصب"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许并安装"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить и установить"
          }
        }
      }
    },
    "Blocked": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مسدود"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已阻止"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокировано"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لغو"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить"
          }
        }
      }
    },
    "Choose a plugin folder (with plugin.json)": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک پوشهٔ افزونه (دارای plugin.json) انتخاب کنید"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个插件文件夹（包含 plugin.json）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку плагина (с plugin.json)"
          }
        }
      }
    },
    "Clone": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کپی"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "克隆"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клонировать"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بستن"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ادامه"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить"
          }
        }
      }
    },
    "Copy to Mac": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کپی به مک"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制到 Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копировать на Mac"
          }
        }
      }
    },
    "Delete %@ and all its data?": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ و همهٔ داده‌هایش حذف شود؟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %@ 及其所有数据？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %@ и все его данные?"
          }
        }
      }
    },
    "Delete…": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить…"
          }
        }
      }
    },
    "Disposable": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک‌بارمصرف"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одноразовая"
          }
        }
      }
    },
    "Disposable: data is gone when the sandbox stops": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک‌بارمصرف: با توقف سندباکس داده‌ها پاک می‌شوند"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性：沙盒停止后数据即被清除"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одноразовая: данные исчезают при остановке песочницы"
          }
        }
      }
    },
    "Each mini VM has its own exit and its own data.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر ماشین مجازی کوچک خروجی و داده‌های خودش را دارد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个迷你虚拟机都有自己的出口和自己的数据。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждой мини-ВМ свой выход и свои данные."
          }
        }
      }
    },
    "Edit": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ویرایش"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правка"
          }
        }
      }
    },
    "Empty": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خالی"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空白"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пустая"
          }
        }
      }
    },
    "Exit": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خروجی"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出口"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выход"
          }
        }
      }
    },
    "From Folder (Unverified)…": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از پوشه (تأییدنشده)…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从文件夹（未验证）…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из папки (не проверено)…"
          }
        }
      }
    },
    "Hide %@": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنهان کردن %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏 %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть %@"
          }
        }
      }
    },
    "Install": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نصب"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установить"
          }
        }
      }
    },
    "Install %@ in %@?": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ در %@ نصب شود؟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %2$@ 中安装 %1$@？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установить %@ в %@?"
          }
        }
      }
    },
    "Install Without These": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نصب بدون این‌ها"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不授予这些权限并安装"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установить без них"
          }
        }
      }
    },
    "It asks to:": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این موارد را می‌خواهد:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它请求："
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оно запрашивает:"
          }
        }
      }
    },
    "It is not from the V2Mac store (Unverified).": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از فروشگاه V2Mac نیست (تأییدنشده)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它不是来自 V2Mac 商店（未验证）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оно не из магазина V2Mac (не проверено)."
          }
        }
      }
    },
    "Layers re-hashed: CHANGED or missing.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هش لایه‌ها دوباره بررسی شد: تغییر کرده یا وجود ندارد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已重新计算层哈希：已更改或缺失。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слои перепроверены: ИЗМЕНЕНЫ или отсутствуют."
          }
        }
      }
    },
    "Layers re-hashed: unchanged since published.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هش لایه‌ها دوباره بررسی شد: از زمان انتشار تغییری نکرده."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已重新计算层哈希：自发布以来未更改。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слои перепроверены: не изменились с публикации."
          }
        }
      }
    },
    "Listed in the signed store index.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در فهرست امضاشدهٔ فروشگاه هست."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已列入签名的商店索引。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть в подписанном индексе магазина."
          }
        }
      }
    },
    "Minimize": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کوچک کردن"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最小化"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свернуть"
          }
        }
      }
    },
    "No exit (blocked)": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون خروجی (مسدود)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无出口（已阻止）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без выхода (заблокировано)"
          }
        }
      }
    },
    "No mini VMs": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ماشین مجازی کوچکی وجود ندارد"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有迷你虚拟机"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет мини-ВМ"
          }
        }
      }
