        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读写此迷你虚拟机的 Shared 文件夹"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читать и записывать папку Shared этой мини-ВМ"
          }
        }
      }
    },
    "Remove %@": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %@"
