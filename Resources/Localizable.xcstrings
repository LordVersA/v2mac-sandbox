    "Sandbox is stopped": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سندباکس متوقف است"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沙盒已停止"
