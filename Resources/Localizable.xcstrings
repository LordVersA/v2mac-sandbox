      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چسباندن از مک"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Mac 粘贴"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставка с Mac"
